{
  "name": "dsh-login-gate",
  "version": "0.1.0",
  "description": "MinuSense login-gate: password login page that redirects into the official dsh web token-to-cookie exchange, enabling access from other devices",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.png",
    "locale",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "private": true
}
