{
  "name": "dsh-yusheng-voice",
  "version": "0.6.0",
  "description": "yusheng voice backend: WebSocket voice protocol over minimax ASR/TTS with LLM turns driven by in-process dsh sessions; settings panel in the web right sidebar",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "examples",
    "PROTOCOL.md",
    "INTERACTION.md",
    "MEMORY.md",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./voice-client": "./lib/voice-client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "pretest": "npm run build",
    "test": "node --test tools/regression.test.mjs tools/client.test.mjs tools/memory.test.mjs && node tools/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "private": true
}
